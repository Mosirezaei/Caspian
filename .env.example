# Supabase (public — used by browser + API routes)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Alanchand currency rates API token (used by /api/cron/sync-rates)
# https://alanchand.com
ALANCHAND_API_TOKEN=your_alanchand_api_token

# Shared secret required by the Vercel/GitHub Actions cron jobs that call
# /api/cron/sync-rates and /api/cron/sync-events
CRON_SECRET=your_cron_secret
